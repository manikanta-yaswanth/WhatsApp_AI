APP_ENV=development

# Async SQLAlchemy URL. Use a dedicated, least-privilege Postgres role.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_ai

OPENAI_API_KEY=your_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=

# Persistent Chromium profile holding the WhatsApp Web session (gitignored).
WHATSAPP_PROFILE_DIR=playwright/.auth/whatsapp_profile
WHATSAPP_HEADLESS=true
MAX_MESSAGES_PER_CONTACT=3
MAX_CHATS_PER_SCRAPE=200
INCLUDE_GROUPS=false

# If set, every API route except /health requires header X-API-Key.
API_KEY=

AGENT_MAX_ITERATIONS=6
JUDGE_THRESHOLD=0.7
JUDGE_MAX_RETRIES=1
