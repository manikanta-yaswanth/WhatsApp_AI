APP_ENV=development

# Separate keys, matching AI_DATA_AGENTS. Use a dedicated database and role.
database=whatsapp_ai
host=localhost
port=5432
user=postgres
password=replace_with_your_local_password

# Optional override; if set, DATABASE_URL takes priority over separate keys.
# Old postgresql+asyncpg:// URLs remain accepted for existing setups.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/whatsapp_ai
# To override "user" from the OS environment, use DB_USER (not OS USER).

# Supabase: use Connect > Session pooler (5432), not a REST URL/API key.
# Replace placeholders locally; URL-encode reserved characters in the password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Use a private schema NOT exposed in Supabase's Data API settings.
# DB_SCHEMA=whatsapp_demo
# Switch to whatsapp_private for real chats; never seed demo data there.
# Leaving DB_SCHEMA unset preserves the existing database search_path.
DB_SCHEMA=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=

# Persistent Chromium profile holding the WhatsApp Web session (gitignored).
WHATSAPP_PROFILE_DIR=playwright/.auth/whatsapp_profile
WHATSAPP_HEADLESS=true
MAX_MESSAGES_PER_CONTACT=3
MAX_CHATS_PER_SCRAPE=200
INCLUDE_GROUPS=false

AGENT_MAX_ITERATIONS=6
JUDGE_THRESHOLD=0.7
JUDGE_MAX_RETRIES=1
